---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Icon from '@ui/icons/Icon.astro';
import Button from '@ui/Button.astro';
import type { WithContext, Thing } from 'schema-dts';

export const pageContent = {
  errorCode: '404',
  title: 'Esta página não existe',
  description: 'Não encontramos a página que você procura.',
  goBackLabel: 'Voltar',
};

const resources = [
  {
    title: 'Central de ajuda',
    description: 'Encontre respostas para dúvidas comuns.',
    icon: 'info',
    link: '/support/knowledge-base',
  },
  {
    title: 'Artigos',
    description: 'Aprenda a organizar o dia a dia do seu MEI.',
    icon: 'articles',
    link: '/support/articles',
  },
  {
    title: 'Guias para MEI',
    description: 'Leia sobre finanças, obrigações e proteção de dados.',
    icon: 'blankDocument',
    link: '/support/whitepapers',
  },
  {
    title: 'Manuais',
    description: 'Consulte o passo a passo de cada funcionalidade.',
    icon: 'documentMagnifyingGlass',
    link: '/support/reference',
  },
];

const seo = {
  title: 'Página não encontrada | Dokei',
  description:
    'Não encontramos a página que você procura. Explore nossos conteúdos ou volte para a página inicial.',
};

const schema: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  inLanguage: 'pt-BR',
  '@id': Astro.url.href,
  url: Astro.url.href,
  name: 'Página não encontrada',
  description:
    'Não encontramos a página que você procura. Explore nossos conteúdos ou volte para a página inicial.',
  isPartOf: {
    '@type': 'WebSite',
    url: `${Astro.site}`,
    name: 'Dokei',
    description:
      'Simplifique a gestão do seu MEI. Ferramentas simples para você focar no que realmente importa: fazer seu negócio crescer.',
  },
};
---

<BaseLayout seo={seo} schema={schema}>
  <section
    class="grid min-h-full place-items-center px-6 pt-32 pb-10 sm:pt-48 lg:px-8"
  >
    <div class="text-center">
      <p class="text-xl font-semibold text-dokei-accent">
        {pageContent.errorCode}
      </p>
      <h1
        class="mt-4 text-4xl text-balance text-dokei-primary sm:text-5xl md:text-6xl lg:text-7xl"
      >
        {pageContent.title}
      </h1>
      <p
        class="mt-6 text-lg font-medium text-pretty text-slate-500 sm:text-xl/8"
      >
        {pageContent.description}
      </p>
    </div>

    <div class="mx-auto w-full px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <div class="mx-auto w-full max-w-lg px-4 sm:px-6 lg:px-8">
        <ul class="divide-y divide-dashed divide-slate-300">
          {
            resources.map(resource => (
              <li>
                <a
                  href={resource.link}
                  class="group flex gap-x-5 px-2 py-8 transition hover:bg-dokei-muted"
                >
                  <Icon name={resource.icon} class="size-6 text-dokei-accent" />
                  <div class="grow">
                    <h3 class="font-semibold text-slate-600 transition group-hover:text-dokei-primary">
                      {resource.title}
                    </h3>
                    <p class="mt-1 text-slate-500">{resource.description}</p>
                  </div>
                  <Icon
                    name="chevronRight"
                    class="self-center text-slate-400 transition"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="mt-5 flex items-center justify-center">
        <Button
          id="go-back"
          variant="primary"
          className="bg-dokei-primary hover:bg-dokei-primary/80 focus:bg-dokei-primary/80"
          >{pageContent.goBackLabel}</Button
        >
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('astro:page-load', async () => {
      const goBackButton = document.getElementById(
        'go-back'
      ) as HTMLButtonElement;

      goBackButton.addEventListener('click', () => {
        history.back();
      });
    });
  </script>
</BaseLayout>
