---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Icon from '@ui/icons/Icon.astro';

// Hero
const preTitle = 'Gratuidade';
const title = 'A Dokei é 100% gratuita para o MEI';
const subTitle =
  'Acreditamos que todo MEI merece boas ferramentas de gestão sem pagar por isso. Todas as ferramentas abaixo fazem parte da mesma conta gratuita.';

// Comparison Table Link
const compareLinkTitle = 'Conheça todas as funcionalidades';
const compareLink = '/downloads/editions';
const compareLinkAriaLabel =
  'Veja a lista das funcionalidades da Dokei para o negócio e para as obrigações do MEI.';

// Free tools, all in the same account
const essentialTier = {
  title: 'Para o seu negócio',
  price: 'R$ 0',
  priceDescription: '/na mesma conta gratuita',
  description: [
    'Para o dia a dia de quem empreende sozinho.',
    'Gere recibos em PDF, registre entradas e saídas separando negócio do pessoal e descubra quanto cobrar pelo seu serviço.',
  ],
  cta: {
    text: 'Começar grátis',
    link: 'https://dokei-web-xhrp.vercel.app/cadastro',
  },
};

const advancedTier = {
  title: 'Para as suas obrigações',
  price: 'R$ 0',
  priceDescription: '/na mesma conta gratuita',
  description: [
    'Para manter o seu MEI em dia.',
    'Acompanhe os lembretes do DAS e da declaração anual e veja quanto movimentou no ano.',
  ],
  cta: {
    text: 'Começar grátis',
    link: 'https://dokei-web-xhrp.vercel.app/cadastro',
  },
};

// Features
const features = [
  {
    title: 'Nossa Missão',
    description:
      'Simplificar a rotina de quem empreende sozinho, tirando a burocracia do caminho para você focar em fazer seu negócio crescer.',
    className: 'rounded-xl lg:rounded-l-xl lg:rounded-r-none',
  },
  {
    title: '100% Gratuito',
    description:
      'Todo MEI merece boas ferramentas de gestão sem pagar por isso. Por isso a Dokei é e continuará sendo gratuita.',
    className: 'rounded-xl lg:rounded-none',
  },
  {
    title: 'Compromisso com Você',
    description:
      'Construímos a Dokei ouvindo quem vive a realidade do MEI todos os dias, sempre priorizando simplicidade e segurança dos seus dados.',
    className: 'rounded-xl lg:rounded-r-xl lg:rounded-l-none',
  },
];

// Info Section
const infoSections = [
  {
    title: 'Onde usar',
    content: [
      'A Dokei é responsiva e funciona no computador, tablet ou celular.',
      'Você pode acessar sua conta e gerenciar seu negócio de onde estiver, a qualquer momento.',
    ],
    className: 'md:row-span-2 md:content-center py-5 sm:p-5',
    icon: null,
  },
  {
    title: null,
    content: [
      `Ainda tem dúvidas? Fale com nosso suporte pelo e-mail <a href='mailto:contato@dokei.com.br' aria-label='E-mail de suporte da Dokei' class="underline hover:text-dokei-primary transition-colors duration-300"
>contato@dokei.com.br</a> ou acesse a <a href='/support/knowledge-base' aria-label='Central de ajuda' class="underline hover:text-dokei-primary transition-colors duration-300"
>central de ajuda</a>.`,
    ],
    className:
      'md:content-center md:border-l border-t md:border-t-0 border-dashed border-slate-400 py-5 sm:p-5',
    icon: 'info',
    iconClass: 'shrink-0 size-8 text-slate-600 mt-6',
  },
  {
    title: 'Seus dados protegidos',
    content: [
      'Não vendemos nem compartilhamos seus dados pessoais com terceiros para fins comerciais. A Dokei segue a Lei Geral de Proteção de Dados (LGPD).',
    ],
    className:
      'md:col-start-2 md:row-start-2 md:content-center md:border-l border-t border-dashed border-slate-400 py-5 sm:p-5',
    icon: null,
  },
];

// SEO metadata for the page
const seo = {
  title: '100% Gratuito | Dokei',
  description:
    'A Dokei é 100% gratuita para o MEI. Sem mensalidades e sem complicação.',
};
---

<BaseLayout seo={seo}>
  <section class="mx-auto max-w-[85rem] px-4 pt-40 pb-12 sm:px-6 lg:px-8">
    <div class="max-w-7xl">
      <div class="mx-auto max-w-xl lg:mx-0">
        <p class="text-base/7 font-medium text-slate-400">{preTitle}</p>
        <h1
          class="mt-1 text-4xl text-balance text-dokei-primary sm:text-5xl md:text-6xl lg:text-7xl"
        >
          {title}
        </h1>
        <p
          class="mt-8 text-lg font-medium text-pretty text-slate-700 sm:text-xl/8"
        >
          {subTitle}
        </p>
        <a
          href={compareLink}
          class="group mt-5 inline-flex items-center justify-center gap-x-2 text-center font-medium text-slate-700 shadow-lg shadow-transparent transition duration-300 hover:text-slate-400 focus:outline-hidden"
          aria-label={compareLinkAriaLabel}
        >
          {compareLinkTitle}
          <Icon name="chevronRight" />
        </a>
      </div>
    </div>
  </section>

  <section
    class="mx-auto mt-16 grid max-w-lg grid-cols-1 items-center gap-y-6 px-4 sm:mt-20 md:px-0 lg:max-w-4xl lg:grid-cols-2 lg:gap-y-0"
  >
    <div
      class="rounded-3xl rounded-t-3xl bg-white/60 p-8 ring-1 ring-slate-900/10 sm:p-10 lg:rounded-tr-none lg:rounded-b-none lg:rounded-bl-3xl"
    >
      <h3 class="text-base/7 font-semibold text-slate-600">
        {essentialTier.title}
      </h3>
      <p class="mt-4 flex items-baseline gap-x-2">
        <span class="text-5xl font-semibold tracking-tight text-slate-900"
          >{essentialTier.price}</span
        >
        <span class="text-base text-slate-500"
          >{essentialTier.priceDescription}</span
        >
      </p>
      {
        essentialTier.description.map((desc, index) => (
          <p
            class={`${index === 0 ? 'mt-6 text-base font-medium text-slate-600' : 'mt-8 text-base/6 text-slate-600 sm:mt-10'} `}
          >
            {desc}
          </p>
        ))
      }
      <a
        href={essentialTier.cta.link}
        aria-describedby={essentialTier.title}
        class="mt-8 block rounded-lg px-3.5 py-2.5 text-center text-sm font-semibold ring-1 ring-dokei-primary transition duration-300 ring-inset hover:bg-dokei-primary/80 hover:text-white focus:bg-dokei-primary focus:text-white focus:outline-hidden sm:mt-10"
      >
        {essentialTier.cta.text}</a
      >
    </div>

    <div
      class="relative flex flex-col justify-evenly rounded-3xl bg-dokei-primary p-8 shadow-2xl ring-1 ring-dokei-primary/10 sm:p-10 lg:h-[120%]"
    >
      <h3 class="text-base/7 font-semibold text-dokei-muted">
        {advancedTier.title}
      </h3>
      <p class="mt-4 flex items-baseline gap-x-2">
        <span class="text-5xl font-semibold tracking-tight text-white"
          >{advancedTier.price}</span
        >
        <span class="text-base text-dokei-border"
          >{advancedTier.priceDescription}</span
        >
      </p>
      {
        advancedTier.description.map((desc, index) => (
          <p
            class={`${index === 0 ? 'mt-6 text-base font-medium text-dokei-muted lg:mt-0' : 'mt-8 text-base/6 text-dokei-muted sm:mt-10'}`}
          >
            {desc}
          </p>
        ))
      }

      <a
        href={advancedTier.cta.link}
        aria-describedby={advancedTier.title}
        class="mt-8 block rounded-lg bg-white px-3.5 py-2.5 text-center text-sm font-semibold text-dokei-primary shadow-xs transition-colors duration-300 hover:bg-white/80 focus:bg-white/80 focus:outline-hidden sm:mt-10"
        >{advancedTier.cta.text}</a
      >
    </div>
  </section>

  <section class="py-24 sm:py-40">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <dl class="grid grid-cols-1 gap-x-3 gap-y-16 text-center lg:grid-cols-3">
        {
          features.map(({ title, description, className }) => (
            <div class={`flex flex-col gap-y-4 bg-dokei-muted p-10 ${className}`}>
              <dt class="text-base/7 text-slate-600">{description}</dt>
              <dd class="order-first text-3xl font-medium tracking-tight text-slate-900">
                <h3>{title}</h3>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section
    class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 md:pb-14 lg:px-8 lg:pb-20"
  >
    <div
      class="relative grid overflow-hidden rounded-3xl bg-dokei-border px-5 py-5 shadow-xl md:grid-cols-2 md:grid-rows-2"
    >
      {
        infoSections.map(({ title, content, className, icon, iconClass }) => (
          <div class={className}>
            {title && (
              <h3 class="text-2xl font-bold tracking-tight text-balance text-dokei-primary">
                {title}
              </h3>
            )}
            {icon && <Icon name={icon} class={iconClass} />}

            {content.map(paragraph => (
              <p class="mt-6 text-lg/8 text-pretty text-slate-700">
                <Fragment set:html={paragraph} />
              </p>
            ))}
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
