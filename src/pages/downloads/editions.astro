---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Icon from '@ui/icons/Icon.astro';

// Hero
const preTitle = 'Funcionalidades';
const title = 'Ferramentas para o Negócio e para as Obrigações';
const description = [
  {
    content:
      'A Dokei reúne em uma única conta gratuita as ferramentas para organizar o dia a dia e as obrigações do seu MEI. Não há edições nem planos para escolher.',
  },
  {
    content:
      'As ferramentas de <strong>Negócio</strong> ajudam a emitir recibos, registrar entradas e saídas e calcular o preço do seu serviço.',
  },
  {
    content:
      'As ferramentas de <strong>Obrigações</strong> ajudam a acompanhar o DAS e a preparar a declaração anual do seu faturamento.',
  },
];

// Feature table
const comparisonData = [
  {
    feature: 'Recibos profissionais em PDF',
    link: '#',
    essential: true,
    advanced: false,
  },
  {
    feature: 'Compartilhamento do recibo pelo WhatsApp',
    link: '#',
    essential: true,
    advanced: false,
  },
  {
    feature: 'Link público do recibo',
    essential: true,
    advanced: false,
  },
  {
    feature: 'Registro de entradas e saídas',
    essential: true,
    advanced: true,
  },
  {
    feature: 'Carteiras Negócio e Pessoal separadas',
    essential: true,
    advanced: false,
  },
  {
    feature: 'Extrato com filtros por carteira e tipo',
    essential: true,
    advanced: false,
  },
  {
    feature: 'Calculadora de Preço',
    essential: true,
    advanced: false,
  },
  {
    feature: 'Lembretes do DAS mensal',
    essential: false,
    advanced: true,
  },
  {
    feature: 'Lembrete da declaração anual (DASN-SIMEI)',
    essential: false,
    advanced: true,
  },
  {
    feature: 'Acompanhamento do limite anual de faturamento',
    essential: true,
    advanced: true,
  },
  {
    feature: 'Gráfico da movimentação mensal',
    essential: true,
    advanced: true,
  },
  {
    feature: 'Histórico de rendimentos por mês',
    essential: true,
    advanced: true,
  },
  {
    feature: 'Assistente virtual Kauane',
    essential: true,
    advanced: true,
  },
];

// Info Section
const infoSection = {
  title: 'Onde usar',
  description:
    'A Dokei é responsiva e funciona no computador, tablet ou celular. Você pode acessar sua conta e gerenciar seu negócio de onde estiver.',
  trialInfo:
    'A Dokei é 100% gratuita. Crie sua conta e comece a organizar seu MEI.',
  buttons: [
    {
      text: 'Já tenho conta',
      link: 'https://dokei-web-xhrp.vercel.app/login',
      style: 'bg-white hover:bg-white/70 text-dokei-primary focus:bg-white/70',
    },
    {
      text: 'Começar grátis',
      link: 'https://dokei-web-xhrp.vercel.app/cadastro',
      style:
        'bg-dokei-primary text-white hover:bg-dokei-primary/80 focus:bg-dokei-primary/80',
    },
  ],
};

// SEO metadata for the page
const seo = {
  title: 'Funcionalidades | Dokei',
  description:
    'Veja as ferramentas da Dokei para o negócio e para as obrigações do MEI.',
};
---

<BaseLayout seo={seo}>
  <section class="bg-linear-to-tl/srgb from-dokei-border via-transparent to-white">
    <div class="mx-auto max-w-[85rem] px-4 pt-40 pb-12 sm:px-6 lg:px-8">
      <div class="max-w-7xl">
        <div class="mx-auto max-w-2xl lg:mx-0">
          <p class="text-base/7 font-medium text-slate-400">{preTitle}</p>
          <h1
            class="mt-1 text-4xl text-balance text-dokei-primary sm:text-5xl md:text-6xl lg:text-7xl"
          >
            {title}
          </h1>
          {
            description.map(desc => (
              <p class="mt-8 text-lg font-medium text-pretty text-slate-700 sm:text-xl/8">
                <Fragment set:html={desc.content} />
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="bg-linear-to-bl/srgb from-dokei-border via-transparent to-white">
    <div
      class="relative mx-auto max-w-[60rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14"
    >
      <div class="hidden py-2 md:block">
        <div class="grid grid-cols-4 gap-6">
          <div class="col-span-1 col-start-3 mx-auto">
            <h3 class="text-center text-lg font-medium text-dokei-primary">
              Negócio
            </h3>
          </div>
          <div class="col-span-1 mx-auto">
            <h3 class="text-center text-lg font-medium text-dokei-primary">
              Obrigações
            </h3>
          </div>
        </div>
      </div>

      <div class="space-y-4 md:space-y-0">
        {
          comparisonData.map(item => (
            <ul class="grid md:grid-cols-4 md:gap-6">
              <li class="pb-1.5 md:col-span-2 md:py-3">
                <span class="flex items-center font-medium text-slate-700 md:font-normal">
                  {item.link ? (
                    <a
                      href={'#!'}
                      rel="noopener noreferrer"
                      class="transition-color group inline-flex items-center gap-x-1 duration-300 hover:text-slate-500"
                    >
                      {item.feature}{' '}
                      <Icon
                        name="info"
                        class="transition-color size-5 shrink-0 text-dokei-primary duration-300 group-hover:text-slate-500"
                      />
                    </a>
                  ) : (
                    item.feature
                  )}
                </span>
              </li>

              <li class={`col-span-1 border-b border-slate-200 py-1.5 md:py-3`}>
                <div class="grid grid-cols-2 sm:grid-cols-4 md:flex">
                  <span class="self-end text-slate-500 sm:col-span-2 md:hidden">
                    Negócio
                  </span>
                  <span class="place-self-center md:mx-auto">
                    {item.essential ? (
                      <Icon
                        name="check"
                        class="size-5 shrink-0 text-dokei-accent"
                      />
                    ) : (
                      <Icon
                        name="minus"
                        class="size-5 shrink-0 text-slate-400"
                      />
                    )}
                  </span>
                </div>
              </li>

              <li class={`col-span-1 border-b border-slate-200 py-1.5 md:py-3`}>
                <div class="grid grid-cols-2 sm:grid-cols-4 md:flex">
                  <span class="self-end text-slate-500 sm:col-span-2 md:hidden">
                    Obrigações
                  </span>
                  <span class="place-self-center md:mx-auto">
                    {item.advanced ? (
                      <Icon
                        name="check"
                        class="size-5 shrink-0 text-dokei-accent"
                      />
                    ) : (
                      <Icon
                        name="minus"
                        class="size-5 shrink-0 text-slate-400"
                      />
                    )}
                  </span>
                </div>
              </li>
            </ul>
          ))
        }
      </div>
    </div>
  </section>
  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20"
  >
    <div
      class="grid divide-y divide-dashed divide-slate-400 rounded-3xl bg-dokei-border px-5 py-5 shadow-xl lg:grid-cols-2 lg:divide-x lg:divide-y-0"
    >
      <div class="content-center py-5 sm:p-5">
        <h3
          class="text-2xl font-bold tracking-tight text-balance text-dokei-primary"
        >
          {infoSection.title}
        </h3>

        <p class="mt-6 text-lg/8 text-pretty text-slate-700">
          {infoSection.description}
        </p>
      </div>

      <div class="py-5 sm:p-5">
        <Icon name="info" class="size-8" />

        <p class="mt-6 mb-8 text-lg/8 text-pretty text-slate-700 sm:mb-10">
          {infoSection.trialInfo}
        </p>

        <div class="mx-auto flex flex-col gap-4 sm:flex-row sm:justify-center">
          {
            infoSection.buttons.map(button => (
              <a
                href={button.link}
                class={`mx-auto flex w-full items-center justify-center rounded-lg px-3.5 py-2.5 text-center text-sm font-semibold transition duration-300 focus:outline-hidden sm:w-1/2 ${button.style}`}
              >
                {button.text}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
