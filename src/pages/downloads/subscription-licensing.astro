---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Icon from '@ui/icons/Icon.astro';

// Hero
const preTitle = 'Conta gratuita';
const title = 'Crie sua conta gratuita na Dokei';
const subTitle =
  'Tenha as ferramentas de gestão do seu MEI em um só lugar, <i>sem planilhas complicadas</i>, <i>sem mensalidades</i> e <i>sem complicação</i>.';

//Features
const features = [
  { text: '100% Gratuito' },
  { text: 'Dashboard Intuitivo' },
  { text: 'Fácil de usar' },
  { text: 'Funciona no celular' },
];

// Sign-up Link
const subscribeLinkTitle = 'Começar grátis agora';
const subscribeLink = 'https://dokei-web-xhrp.vercel.app/cadastro';

// Info Section
const infoSection = {
  systemRequirements: {
    title: 'Onde usar',
    description:
      'A Dokei é responsiva e funciona no computador, tablet ou celular. Você pode acessar sua conta e gerenciar seu negócio de onde estiver, a qualquer momento.',
  },
  subscriptionInfo: {
    description:
      'A conta da Dokei não tem mensalidade. Você pode solicitar a qualquer momento o acesso, a correção ou a exclusão dos seus dados pessoais pelo nosso canal de suporte.',
  },
};

// FAQ Section
const faqSection = {
  title: 'Dúvidas Frequentes',
  faqs: [
    {
      question: 'O que é a Dokei e como ela pode me ajudar?',
      answer:
        'A Dokei é uma plataforma de gestão criada especialmente para Microempreendedores Individuais (MEI). Com ela, você pode emitir recibos profissionais, controlar suas finanças, receber lembretes do DAS, calcular preços dos seus serviços e muito mais.',
    },
    {
      question: 'Como emito um recibo na Dokei?',
      answer:
        'Acesse a seção Recibos, clique em Novo Recibo e preencha os dados do cliente e do serviço prestado. Depois, é só baixar o PDF ou compartilhar pelo WhatsApp, sem nenhum custo.',
    },
    {
      question: 'O que são as obrigações DAS e DASN?',
      answer:
        'O DAS (Documento de Arrecadação do Simples Nacional) é o boleto mensal que todo MEI precisa pagar. Já a DASN (Declaração Anual do Simples Nacional) é entregue até maio de cada ano. A Dokei mostra esses prazos em um só painel.',
    },
    {
      question: 'Posso usar a Dokei no celular?',
      answer:
        'Sim! A Dokei é totalmente responsiva e funciona em qualquer dispositivo, seja no computador, tablet ou celular.',
    },
    {
      question: 'Como funciona a Calculadora de Preço?',
      answer:
        'A calculadora considera o valor da sua hora, o tempo dedicado ao serviço, os custos extras e a margem de lucro desejada para sugerir o preço. Em 30 segundos, você descobre quanto cobrar.',
    },
  ],
};

// SEO metadata for the page
const seo = {
  title: 'Conta gratuita e dúvidas | Dokei',
  description:
    'Crie sua conta gratuita na Dokei e veja as dúvidas mais frequentes do MEI.',
};
---

<BaseLayout seo={seo}>
  <section class="mx-auto max-w-[85rem] px-4 pt-40 pb-12 sm:px-6 lg:px-8">
    <div class="max-w-7xl">
      <div class="mx-auto max-w-2xl lg:mx-0">
        <p class="text-base/7 font-medium text-slate-400">
          {preTitle}
        </p>
        <h1
          class="mt-1 text-4xl text-balance text-dokei-primary sm:text-5xl md:text-6xl lg:text-7xl"
        >
          {title}
        </h1>
        <p
          class="mt-8 text-lg font-medium text-pretty text-slate-700 sm:text-xl/8"
        >
          <Fragment set:html={subTitle} />
        </p>

        <div
          class="mt-10 grid auto-rows-fr grid-rows-2 gap-2 sm:gap-6 md:grid-cols-2"
        >
          {
            features.map(feature => (
              <div class="flex gap-x-2">
                <Icon name="checkCircle" class="text-dokei-accent!" />
                <div class="grow">
                  <p class="text-slate-600">{feature.text}</p>
                </div>
              </div>
            ))
          }
        </div>

        <a
          href={subscribeLink}
          class="mt-8 block rounded-lg bg-dokei-primary px-3.5 py-2.5 text-center font-semibold text-white shadow-xs transition-colors duration-300 hover:bg-dokei-primary/80 focus:bg-dokei-primary/80 focus:outline-hidden sm:mt-10 sm:w-1/2"
        >
          {subscribeLinkTitle}</a
        >
      </div>
    </div>
  </section>

  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20"
  >
    <div
      class="relative grid divide-y divide-dashed divide-slate-400 overflow-hidden rounded-3xl bg-dokei-border px-5 py-5 shadow-xl md:grid-cols-2 md:divide-x md:divide-y-0"
    >
      <div class="content-center py-5 sm:p-5">
        <h3
          class="text-2xl font-bold tracking-tight text-balance text-dokei-primary"
        >
          {infoSection.systemRequirements.title}
        </h3>
        <p class="mt-6 text-lg/8 text-pretty text-slate-700">
          {infoSection.systemRequirements.description}
        </p>
      </div>

      <div class="svgBlock py-5 sm:p-5">
        <Icon name="info" class="size-8" />
        <p class="mt-6 text-lg/8 text-pretty text-slate-700">
          {infoSection.subscriptionInfo.description}
        </p>
      </div>
    </div>
  </section>

  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20"
  >
    <div class="mx-auto mb-10 max-w-2xl lg:mb-14">
      <h2
        class="text-2xl font-semibold tracking-tight text-balance text-dokei-primary md:text-3xl md:leading-tight"
      >
        {faqSection.title}
      </h2>
    </div>

    <div class="mx-auto max-w-2xl divide-y divide-slate-200">
      {
        faqSection.faqs.map(faq => (
          <div class="py-8 first:pt-0 last:pb-0">
            <div class="flex gap-x-5">
              <Icon name="questionMark" />

              <div class="grow">
                <h3 class="font-semibold text-slate-600 md:text-lg">
                  {faq.question}
                </h3>
                <p class="mt-1 text-slate-500">
                  <Fragment set:html={faq.answer} />
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <style>
    .svgBlock::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url(/guilloche.svg);
      background-repeat: repeat;
      background-position: right top;
      background-size: 20px, 20px;
      opacity: 0.075;
      background-clip: padding-box;
      mask-image: linear-gradient(270deg, rgb(0, 0, 0), rgba(0, 0, 0, 0));
      pointer-events: none;
    }
  </style>
</BaseLayout>
