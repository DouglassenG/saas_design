---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Icon from '@ui/icons/Icon.astro';

// Hero
const preTitle = 'Comece grátis';
const title = 'Comece a usar a Dokei no seu MEI';
const subTitle =
  'Crie sua conta e acesse a Dokei pelo navegador, no computador, tablet ou celular. Organize seu negócio, emita recibos e mantenha suas obrigações em dia.';

// Comparison Table Link
const compareLinkTitle = 'Conheça todas as funcionalidades';
const compareLink = '/downloads/editions';
const compareLinkAriaLabel =
  'Veja a lista das funcionalidades da Dokei para o negócio e para as obrigações do MEI.';

// Access options
const essentialTier = {
  title: 'Já tenho conta',
  description:
    'Entre para emitir recibos, registrar entradas e saídas, acompanhar o DAS e consultar seus rendimentos do ano.',
  cta: {
    text: 'Entrar',
    link: 'https://dokei-web-xhrp.vercel.app/login',
  },
};

const advancedTier = {
  title: 'Quero começar',
  description:
    'Crie sua conta gratuita e tenha em um só lugar as ferramentas pensadas especialmente para quem empreende sozinho.',
  cta: {
    text: 'Começar grátis',
    link: 'https://dokei-web-xhrp.vercel.app/cadastro',
  },
};

// Small Info Section
const smallInfoSection = {
  intro: {
    text: 'A Dokei é 100% gratuita: sem planilhas complicadas, sem mensalidades, sem complicação.',
  },
  links: [
    {
      text: 'Termos de Uso',
      href: '#',
      ariaLabel: 'Termos de Uso da Dokei',
    },
    {
      text: 'Ver as funcionalidades',
      href: '/downloads/editions',
      ariaLabel: 'Ver as funcionalidades da Dokei',
    },
  ],
};

// Large Info Section

const largeInfoSection = {
  olderReleases: {
    title: 'O que você encontra na Dokei',
    content: 'Acesse as ferramentas com a sua conta:',
    versions: [
      {
        version: 'Emitir Recibo',
        href: 'https://dokei-web-xhrp.vercel.app/recibos',
      },
      {
        version: 'Controle Financeiro',
        href: 'https://dokei-web-xhrp.vercel.app/financeiro',
      },
      {
        version: 'Lembretes DAS',
        href: 'https://dokei-web-xhrp.vercel.app/obrigacoes',
      },
      {
        version: 'Declaração de Rendimentos',
        href: 'https://dokei-web-xhrp.vercel.app/rendimentos',
      },
      {
        version: 'Calculadora de Preço',
        href: 'https://dokei-web-xhrp.vercel.app/calculadora',
      },
      {
        version: 'Extrato',
        href: 'https://dokei-web-xhrp.vercel.app/financeiro/extrato',
      },
    ],
  },
  systemRequirements: {
    title: 'Onde usar',
    content:
      'A Dokei é responsiva e funciona no computador, tablet ou celular. Você pode acessar sua conta e gerenciar seu negócio de onde estiver.',
  },
  excel2003: {
    title: 'Precisa de ajuda?',
    content:
      'Converse com a assistente virtual Kauane dentro da plataforma ou consulte nossos conteúdos:',
    versions: [
      {
        version: 'Manuais',
        href: '/support/reference',
      },
      {
        version: 'Central de ajuda',
        href: '/support/knowledge-base',
      },
    ],
  },
};

// SEO metadata for the page
const seo = {
  title: 'Comece a usar a Dokei | Dokei',
  description:
    'Crie sua conta gratuita na Dokei e organize seu MEI pelo computador, tablet ou celular.',
};
---

<BaseLayout seo={seo}>
  <section class="mx-auto max-w-[85rem] px-4 pt-40 pb-12 sm:px-6 lg:px-8">
    <div class="max-w-7xl">
      <div class="mx-auto max-w-2xl lg:mx-0">
        <p class="text-base/7 font-medium text-slate-400">{preTitle}</p>
        <h1
          class="mt-1 text-4xl text-balance text-dokei-primary sm:text-5xl md:text-6xl lg:text-7xl"
        >
          {title}
        </h1>
        <p
          class="mt-8 max-w-xl text-lg font-medium text-pretty text-slate-700 sm:text-xl/8"
        >
          {subTitle}
        </p>
        <a
          class="group mt-5 inline-flex items-center justify-center gap-x-2 text-center font-medium text-slate-700 shadow-lg shadow-transparent transition duration-300 hover:text-dokei-primary focus:outline-hidden"
          href={compareLink}
          aria-label={compareLinkAriaLabel}
        >
          {compareLinkTitle}
          <Icon name="chevronRight" />
        </a>
      </div>
    </div>
  </section>

  <section
    class="mx-auto mt-16 grid max-w-lg grid-cols-1 items-center gap-y-6 px-4 sm:mt-20 md:px-0 lg:max-w-4xl lg:grid-cols-2 lg:gap-y-0"
  >
    <div
      class="rounded-3xl rounded-t-3xl bg-white/60 p-8 ring-1 ring-slate-900/10 sm:p-10 lg:rounded-tr-none lg:rounded-b-none lg:rounded-bl-3xl"
    >
      <h3 class="text-3xl font-semibold text-slate-600">
        {essentialTier.title}
      </h3>

      <p class="mt-8 text-base/6 text-slate-600 sm:mt-10">
        {essentialTier.description}
      </p>
      <a
        href={essentialTier.cta.link}
        aria-describedby={essentialTier.title}
        class="mt-8 block rounded-lg px-3.5 py-2.5 text-center text-sm font-semibold ring-1 ring-dokei-primary transition duration-300 ring-inset hover:bg-dokei-primary/80 hover:text-white focus:bg-dokei-primary focus:text-white focus:outline-hidden sm:mt-10"
        >{essentialTier.cta.text}</a
      >
    </div>

    <div
      class="relative flex flex-col justify-evenly rounded-3xl bg-dokei-primary p-8 shadow-2xl ring-1 ring-dokei-primary/10 sm:p-10 lg:h-[120%]"
    >
      <h3 class="text-4xl/7 font-semibold text-dokei-muted">
        {advancedTier.title}
      </h3>

      <p class="mt-8 text-lg/6 text-dokei-muted sm:mt-10">
        {advancedTier.description}
      </p>

      <a
        href={advancedTier.cta.link}
        aria-describedby={advancedTier.title}
        class="mt-8 block rounded-lg bg-white px-3.5 py-2.5 text-center text-sm font-semibold text-dokei-primary shadow-xs transition-colors duration-300 hover:bg-white/80 focus:bg-white/80 focus:outline-hidden sm:mt-10"
        >{advancedTier.cta.text}</a
      >
    </div>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 pt-32 pb-16 sm:px-6 lg:px-8">
    <div
      class="mx-auto grid grid-rows-1 content-center divide-y divide-dashed divide-slate-300 lg:mx-0 lg:grid-cols-2 lg:divide-x lg:divide-y-0"
    >
      <div class="py-5 sm:p-5">
        <p
          class="inline-flex gap-x-4 font-medium text-pretty text-slate-700 sm:text-lg/8"
        >
          <Icon name="info" class="size-8" />
          {smallInfoSection.intro.text}
        </p>
      </div>
      <div class="flex flex-col justify-evenly p-5">
        {
          smallInfoSection.links.map((link, index) => (
            <a
              class={`${index === 1 ? 'mt-5' : ''} group inline-flex w-fit items-center gap-x-2 font-medium text-slate-700 transition duration-300 hover:text-dokei-primary focus:outline-hidden`}
              href={link.href}
              download={index === 0 ? link.href.split('/').pop() : undefined}
              aria-label={link.ariaLabel}
            >
              {link.text}
              <Icon name="chevronRight" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 md:py-14 lg:px-8 lg:py-20"
  >
    <div
      class="grid rounded-3xl bg-dokei-border px-5 py-5 shadow-xl md:grid-cols-2 md:grid-rows-2"
    >
      <div class="py-5 sm:p-5 md:row-span-2 md:content-center">
        <h3
          class="text-2xl font-bold tracking-tight text-balance text-dokei-primary"
        >
          {largeInfoSection.olderReleases.title}
        </h3>

        <p class="mt-6 text-lg/8 text-pretty text-slate-700">
          {largeInfoSection.olderReleases.content}
        </p>

        <ul class="mt-6 list-inside list-none px-5 text-slate-700">
          {
            largeInfoSection.olderReleases.versions.map((release, index) => (
              <li class={`${index % 2 === 1 ? 'mb-6' : ''}`}>
                <a
                  href={release.href}
                  class="transition duration-300 hover:text-dokei-primary hover:underline"
                >
                  {release.version}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="border-t border-dashed border-slate-400 py-5 sm:p-5 md:content-center md:border-t-0 md:border-l"
      >
        <h3
          class="text-2xl font-bold tracking-tight text-balance text-dokei-primary"
        >
          {largeInfoSection.systemRequirements.title}
        </h3>
        <p class="mt-6 text-lg/8 text-pretty text-slate-700">
          {largeInfoSection.systemRequirements.content}
        </p>
      </div>
      <div
        class="border-t border-dashed border-slate-400 py-5 sm:p-5 md:col-start-2 md:row-start-2 md:content-center md:border-l"
      >
        <h3
          class="text-2xl font-bold tracking-tight text-balance text-dokei-primary"
        >
          {largeInfoSection.excel2003.title}
        </h3>

        <p class="mt-6 text-lg/8 text-pretty text-slate-700">
          {largeInfoSection.excel2003.content}
        </p>

        <ul class="mt-6 list-inside list-none px-5 text-slate-700">
          {
            largeInfoSection.excel2003.versions.map(version => (
              <li>
                <a
                  href={version.href}
                  class="transition duration-300 hover:text-dokei-primary hover:underline"
                >
                  {version.version}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <style>
    .svgBlock::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url(/guilloche.svg);
      background-repeat: repeat;
      background-position: right top;
      background-size: 20px, 20px;
      opacity: 0.075;
      background-clip: padding-box;
      mask-image: linear-gradient(270deg, rgb(0, 0, 0), rgba(0, 0, 0, 0));
      pointer-events: none;
    }
  </style>
</BaseLayout>
