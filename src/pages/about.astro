---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import type { WithContext, Thing } from 'schema-dts';

// Data describing the "About" section content
const aboutData = {
  title: 'Feita por quem entende o desafio de empreender sozinho',
  description:
    'A Dokei nasceu para resolver um problema real: a falta de ferramentas simples e acessíveis para o Microempreendedor Individual organizar seu negócio. Sem planilhas complicadas, sem mensalidades, sem complicação.',
  statistics: [
    {
      label: 'Gratuito para o MEI',
      value: '100%',
    },
    {
      label: 'Ferramentas em um só lugar',
      value: '5',
    },
    {
      label: 'Carteiras separadas: Negócio e Pessoal',
      value: '2',
    },
  ],
};

// Data describing the expertise section
const expertiseData = {
  title: 'O que nos move:',
  expertise: [
    {
      title: 'Nossa Missão',
      description:
        'Simplificar a rotina de quem empreende sozinho, tirando a burocracia do caminho para você focar em fazer seu negócio crescer.',
    },
    {
      title: '100% Gratuito',
      description:
        'Acreditamos que todo MEI merece boas ferramentas de gestão sem pagar por isso. Por isso a Dokei é e continuará sendo gratuita.',
    },
    {
      title: 'Compromisso com Você',
      description:
        'Construímos a Dokei ouvindo quem vive a realidade do MEI todos os dias, sempre priorizando simplicidade e segurança dos seus dados.',
    },
  ],
};

// SEO metadata for the page
const seo = {
  title: 'Quem Somos | Dokei',
  description:
    'Conheça a missão da Dokei e por que a plataforma é 100% gratuita para o MEI.',
};

// Schema.org metadata for SEO
const schema: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  inLanguage: 'pt-BR',
  '@id': Astro.url.href,
  url: Astro.url.href,
  name: 'Quem Somos | Dokei',
  description:
    'Conheça a missão da Dokei e por que a plataforma é 100% gratuita para o MEI.',
  isPartOf: {
    '@type': 'WebSite',
    url: `${Astro.site}`,
    name: 'Dokei',
    description:
      'Simplifique a gestão do seu MEI. Ferramentas simples para você focar no que realmente importa: fazer seu negócio crescer.',
  },
};
---

<BaseLayout seo={seo} schema={schema}>
  <section class="mx-auto max-w-[85rem] px-4 pt-48 pb-12 sm:px-6 lg:px-8">
    <div class="max-w-7xl">
      <div class="mx-auto max-w-2xl lg:mx-0">
        <h1
          class="text-4xl text-balance text-dokei-primary sm:text-5xl md:text-6xl lg:text-7xl"
        >
          {aboutData.title}
        </h1>
        <p
          class="mt-8 text-lg font-medium text-pretty text-slate-700 sm:text-xl/8"
        >
          {aboutData.description}
        </p>
      </div>

      {/* Statistics Section */}
      <div class="mx-auto mt-10 max-w-2xl lg:mx-0 lg:max-w-none">
        <dl
          class="mt-16 grid grid-cols-1 gap-8 sm:mt-20 sm:grid-cols-2 lg:grid-cols-4"
        >
          {
            aboutData.statistics.map(stat => (
              <div class="flex flex-col-reverse gap-1">
                <dt class="text-base/7 text-slate-700">{stat.label}</dt>
                <dd class="text-4xl font-semibold tracking-tight text-dokei-primary">
                  {stat.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {/* Expertise Section */}
  <section class="mx-auto max-w-[85rem] px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <div
      class="group relative isolate overflow-hidden rounded-3xl bg-dokei-border p-5 sm:p-11"
    >
      <div
        class="group to-off-white pointer-events-none absolute inset-0 -top-[10%] h-[120%] w-full rounded-xl from-dokei-border bg-linear-to-r/srgb opacity-0 transition duration-1000 group-hover:opacity-100"
      >
      </div>
      <div class="svgBlock mx-auto max-w-7xl">
        <h2
          class="relative pl-4 text-2xl font-semibold text-balance text-dokei-primary md:text-3xl md:leading-tight"
        >
          {expertiseData.title}
        </h2>
        <dl
          class="relative mt-10 grid max-w-xl grid-cols-1 items-start text-base/7 text-slate-600 sm:max-w-none lg:grid-flow-row-dense lg:auto-rows-fr lg:grid-cols-3"
        >
          {
            expertiseData.expertise.map((item, index) => (
              <div
                class={`px-5 py-5 sm:px-10 lg:py-0 ${index === 1 ? 'h-full border-y border-dashed border-slate-400 lg:border-x lg:border-y-0' : ''}`}
              >
                <dt class="text-lg font-semibold text-balance text-slate-600">
                  {item.title}
                </dt>
                <dd class="mt-2 text-pretty text-slate-700">
                  {item.description}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <style>
    .svgBlock::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url(/guilloche.svg);
      background-repeat: repeat;
      background-position: right top;
      background-size: 20px, 20px;
      opacity: 0.075;
      background-clip: padding-box;
      mask-image: linear-gradient(270deg, rgb(0, 0, 0), rgba(0, 0, 0, 0));
      pointer-events: none;
    }
  </style>
</BaseLayout>
