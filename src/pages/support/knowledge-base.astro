---
import BaseLayout from '@layout/BaseLayout.astro';

export const pageContent = {
  pageTitle: 'Central de ajuda',
  content:
    'Nossa central de ajuda ainda está em construção, e alguns assuntos podem não aparecer aqui. Se você não encontrar o que procura, fale com nosso suporte pelo e-mail contato@dokei.com.br ou converse com a assistente virtual Kauane dentro da Dokei.',
};

const seo = {
  title: 'Central de ajuda | Dokei',
  description:
    'Encontre ajuda para usar a Dokei: recibos, controle financeiro, lembretes DAS, rendimentos e calculadora de preço.',
};
---

<BaseLayout seo={seo}>
  <section
    class="from-dokei-border bg-linear-to-br/srgb via-transparent to-white"
  >
    <div class="mx-auto max-w-[85rem] px-4 pt-48 pb-12 sm:px-6 lg:px-8">
      <div class="max-w-7xl">
        <div class="mx-auto max-w-3xl lg:mx-0">
          <h1
            class="text-4xl text-balance text-dokei-primary sm:text-5xl md:text-6xl lg:text-7xl"
          >
            {pageContent.pageTitle}
          </h1>
          <p
            class="mt-8 text-lg font-medium text-pretty text-slate-700 sm:text-xl/8"
          >
            {pageContent.content}
          </p>
        </div>
      </div>
    </div>
  </section>
  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20"
  >
  </section>
</BaseLayout>
