---
const formStrings = {
  legend: 'Newsletter da Dokei',
  placeholder: 'Digite seu e-mail',
  submit: 'Enviar',
};
---

<form class="w-full md:w-1/2 xl:w-1/3">
  {/* Fieldset for grouping form elements */}
  <fieldset
    class="flex flex-col items-center gap-2 rounded-lg bg-dokei-border p-2 sm:flex-row sm:gap-3"
    aria-labelledby="form-legend"
  >
    {/* Visible legend for screen readers */}
    <legend id="form-legend" class="sr-only text-lg font-medium text-slate-700"
      >{formStrings.legend}</legend
    >

    {/* Email input */}
    <div class="w-full">
      <label for="email-input" class="sr-only">{formStrings.placeholder}</label>
      <input
        type="email"
        id="email-input"
        name="email"
        class="block w-full rounded-lg border-transparent px-4 py-3 text-sm focus:border-dokei-primary focus:ring-dokei-primary"
        placeholder={formStrings.placeholder}
        required
        aria-label={formStrings.placeholder}
        aria-describedby="form-description"
        autocomplete="email"
        spellcheck="false"
      />
    </div>

    {/* Submit button */}
    <button
      type="submit"
      class="inline-flex w-full items-center justify-center gap-x-2 rounded-lg border border-transparent bg-dokei-primary p-3 text-sm font-medium whitespace-nowrap text-white transition duration-300 hover:bg-dokei-primary/80 hover:text-white focus:bg-dokei-primary/80 focus:text-white focus:outline-hidden sm:w-auto"
      aria-label="Enviar e-mail"
    >
      {formStrings.submit}
    </button>
  </fieldset>
</form>
