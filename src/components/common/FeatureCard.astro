---
import Icon from '@ui/icons/Icon.astro';
const { icon, description, styleClass } = Astro.props;
---

<div
  class={`z-10 flex w-2/3 flex-col rounded-xl bg-white/70 p-4 shadow-lg ring-1 ring-white/5 backdrop-blur-xl md:p-5 xl:w-1/2 ${styleClass}`}
>
  <p class="mt-1 text-dokei-primary text-xs font-medium uppercase">
    <Icon name={icon} class="size-6" />
  </p>
  <p class="mt-2 text-slate-700">
    {description}
  </p>
</div>
