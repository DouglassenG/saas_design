---
import Icon from '@ui/icons/Icon.astro';
import { featuresMenu } from '@utils/megaMenu/features';
const sectionDescription = 'Tudo que você precisa para gerir seu MEI';
const currentPath = Astro.url.pathname;
---

<div
  class="hs-dropdown [--adaptive:none] [--is-collapse:true] [--strategy:static] xl:[--is-collapse:false] xl:[--strategy:absolute] xl:[--trigger:hover]"
>
  <button
    id="mega-menu-features"
    type="button"
    class={`hs-dropdown-toggle flex w-full items-center rounded-lg p-2 font-medium text-dokei-primary hover:bg-dokei-muted focus:bg-dokei-muted focus:outline-hidden ${
      currentPath.startsWith('/features') ? 'underline underline-offset-4' : ''
    }`}
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label="Menu Serviços"
  >
    Serviços <Icon name="arrowDownRight" />
  </button>

  <div
    class="hs-dropdown-menu hs-dropdown-open:opacity-100 relative start-0 top-full z-10 mt-2 hidden w-full max-w-(--breakpoint-md) min-w-60 opacity-0 transition-[opacity,margin] duration-150 before:absolute before:start-0 before:-top-5 before:h-5 before:w-full xl:left-1/2 xl:-translate-x-1/2 xl:duration-300"
    role="menu"
    aria-orientation="vertical"
    aria-labelledby="mega-menu-features"
  >
    <div
      class="from-dokei-muted xl:ring-dokei-primary/5 via-transparent to-white px-4 py-2 lg:mx-8 xl:mx-6 xl:rounded-lg xl:bg-white xl:bg-linear-to-t/srgb xl:px-16 xl:py-10 xl:shadow-lg xl:ring-1"
    >
      <p class="text-dokei-muted-foreground text-sm">
        {sectionDescription}
      </p>
      <hr class="border-dokei-border mb-5 border" />

      <div class="gap-4 py-1 md:grid md:grid-cols-2 md:p-2">
        {
          featuresMenu.map(section => (
            <div class="flex flex-col">
              <p class="text-dokei-muted-foreground text-sm">
                {section.sectionTitle}
              </p>

              {section.items.map(item => (
                <a
                  class="hover:bg-dokei-muted focus:bg-dokei-muted flex gap-x-4 rounded-lg p-3 focus:outline-hidden"
                  href={item.href}
                >
                  <Icon
                    name={item.icon}
                    class="text-dokei-primary mt-1 size-5 shrink-0"
                  />

                  <div class="grow">
                    <p class="text-dokei-primary text-sm font-medium">
                      {item.title}
                    </p>
                    <p class="text-dokei-muted-foreground text-sm">
                      {item.description}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>
