---
import Icon from '@ui/icons/Icon.astro';
---

<div class="flex flex-col gap-4">
  <div
    class="z-10 flex items-center justify-center gap-2 rounded-md bg-white px-4 py-2 text-sm text-slate-700 shadow-lg"
  >
    <Icon name="fileText" class="text-dokei-accent size-5" />
    Recibos
  </div>
  <div
    class="z-10 flex items-center justify-center gap-2 rounded-md bg-white px-4 py-2 text-sm text-slate-700 shadow-lg"
  >
    <Icon name="trendingUp" class="text-dokei-accent size-5" />
    Financeiro
  </div>
  <div
    class="z-10 flex items-center justify-center gap-2 rounded-md bg-white px-4 py-2 text-sm text-slate-700 shadow-lg"
  >
    <Icon name="bell" class="text-dokei-accent size-5" />
    Lembretes DAS
  </div>
  <div
    class="z-10 flex items-center justify-center gap-2 rounded-md bg-white px-4 py-2 text-sm text-slate-700 shadow-lg"
  >
    <Icon name="calculator" class="text-dokei-accent size-5" />
    Calculadora
  </div>
</div>
<div
  class="text-dokei-primary z-10 flex items-center justify-center gap-2 rounded-md bg-white p-4 text-sm font-semibold shadow-lg"
>
  <Icon name="portfolio" class="text-dokei-primary size-5" />

  Dokei
</div>
<div
  class="z-10 flex items-center justify-center gap-2 rounded-md bg-white px-4 py-2 text-sm text-slate-700 shadow-lg"
>
  <Icon name="fileSpreadsheet" class="text-dokei-accent size-5" /> Rendimentos
</div>
<div
  class="beam-container pointer-events-none absolute top-1 left-[-15%] hidden h-full md:flex md:items-center lg:left-0 xl:top-0"
>
  <svg
    class="transform-gpu stroke-2"
    width="568"
    height="290"
    viewBox="0 0 568 290"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- Base paths -->
    <path class="path-base" d="M 99.8359375,61 Q 199.74609375,61 299.65625,145"
    ></path>
    <path
      class="path-base"
      d="M 99.8359375,117 Q 199.74609375,117 299.65625,145"></path>
    <path
      class="path-base"
      d="M 99.8359375,173 Q 199.74609375,173 299.65625,145"></path>
    <path
      class="path-base"
      d="M 99.8359375,229 Q 199.74609375,229 299.65625,145"></path>
    <path class="path-base" d="M 299.65625,145 Q 391.734375,145 483.8125,145"
    ></path>

    <!-- Animated beams -->
    <path
      class="path-beam beam-1"
      d="M 99.8359375,61 Q 199.74609375,61 299.65625,145"></path>
    <path
      class="path-beam beam-2"
      d="M 99.8359375,117 Q 199.74609375,117 299.65625,145"></path>
    <path
      class="path-beam beam-3"
      d="M 99.8359375,173 Q 199.74609375,173 299.65625,145"></path>
    <path
      class="path-beam beam-4"
      d="M 99.8359375,229 Q 199.74609375,229 299.65625,145"></path>
    <path
      class="path-beam beam-5"
      d="M 299.65625,145 Q 391.734375,145 483.8125,145"></path>
  </svg>
</div>
<div
  class="beam-container pointer-events-none absolute left-1/2 flex h-4/5 -translate-x-1/2 md:hidden"
>
  <svg
    width="3"
    height="300"
    viewBox="0 0 2 300"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <line
      class="path-base"
      x1="1.48047"
      y1="300"
      x2="1.48047"
      y2="0.980392"
      stroke="var(--color-slate-200)"
      stroke-width="2.5"></line>
    <line
      class="path-beam beam-mobile"
      x1="1.48047"
      y1="300"
      x2="1.48047"
      y2="0.980392"
      stroke="var(--color-dokei-secondary)"
      stroke-width="2.5"></line>
  </svg>
</div>
<style>
  :root {
    --color-slate-200: oklch(0.929 0.013 255.508);
    --color-dokei-secondary: #7ba23f;
  }

  .path-base {
    stroke: var(--color-slate-200);
    stroke-width: 2.5px;
    stroke-linecap: round;
    fill: none;
  }

  /* Animated beam styling */
  .path-beam {
    stroke-width: 2.5px;
    stroke-linecap: round;
    fill: none;
    filter: drop-shadow(0 0 2px rgba(123, 162, 63, 0.2));
  }

  /* Animation for each beam */
  .beam-1 {
    stroke: var(--color-dokei-secondary);
    stroke-dasharray: 250;
    stroke-dashoffset: 250;
    animation: dash 4s ease-in-out infinite;
    animation-delay: 0s;
  }

  .beam-2 {
    stroke: var(--color-dokei-secondary);
    stroke-dasharray: 200;
    stroke-dashoffset: 200;
    animation: dash 4.5s ease-in-out infinite;
    animation-delay: 2.3s;
  }

  .beam-3 {
    stroke: var(--color-dokei-secondary);
    stroke-dasharray: 280;
    stroke-dashoffset: 280;
    animation: dash 5s ease-in-out infinite;
    animation-delay: 1.2s;
  }

  .beam-4 {
    stroke: var(--color-dokei-secondary);
    stroke-dasharray: 300;
    stroke-dashoffset: 300;
    animation: dash 4.8s ease-in-out infinite;
    animation-delay: 3.1s;
  }

  .beam-5 {
    stroke: var(--color-dokei-secondary);
    stroke-dasharray: 220;
    stroke-dashoffset: 220;
    animation: dash 5.2s ease-in-out infinite;
    animation-delay: 0.7s;
  }

  @keyframes dash {
    0% {
      stroke-dashoffset: 250;
      opacity: 0;
    }
    25% {
      opacity: 1;
    }
    50% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    75% {
      opacity: 0.5;
    }
    100% {
      stroke-dashoffset: -250;
      opacity: 0;
    }
  }

  .beam-mobile {
    stroke-dasharray: 300;
    stroke-dashoffset: 300;
    animation: dash-mobile 4s ease-in-out infinite;
  }

  @keyframes dash-mobile {
    0% {
      stroke-dashoffset: -300;
      opacity: 0;
    }
    25% {
      opacity: 1;
    }
    50% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    75% {
      opacity: 0.5;
    }
    100% {
      stroke-dashoffset: 300;
      opacity: 0;
    }
  }
</style>
