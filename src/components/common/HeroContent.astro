---
import Button from '@ui/Button.astro';

const title = 'Gestão simples para MEI';
const subTitle =
  'Chega de planilhas confusas e burocracia. Organize seu negócio, emita recibos e mantenha suas obrigações em dia — tudo em um só lugar.';
const secondaryCTA = {
  text: 'Já tenho conta',
  href: 'https://dokei-web-xhrp.vercel.app/login',
};
const primaryCTA = {
  text: 'Começar grátis',
  href: 'https://dokei-web-xhrp.vercel.app/cadastro',
};
---

{/* Hero Content */}
<div class="mx-auto max-w-4xl text-left select-none sm:text-center">
  <h1
    class="text-dokei-primary block text-4xl text-balance sm:text-5xl md:text-6xl lg:text-7xl"
  >
    {title}
  </h1>
</div>

<div class="mx-auto max-w-3xl text-left sm:text-center">
  <p class="text-lg text-pretty text-slate-700">
    {subTitle}
  </p>
</div>

{/* CTA Buttons */}
<div class="flex flex-col justify-center gap-5 sm:flex-row">
  <Button
    href={secondaryCTA.href}
    variant="secondary"
    className="border-dokei-primary text-dokei-primary hover:border-dokei-primary hover:bg-dokei-primary hover:text-white"
    >{secondaryCTA.text}</Button
  >
  <Button
    href={primaryCTA.href}
    variant="primary"
    className="bg-dokei-primary hover:bg-dokei-primary/80 focus:bg-dokei-primary/80"
    >{primaryCTA.text}</Button
  >
</div>
