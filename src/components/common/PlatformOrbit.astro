---
import Icon from '@ui/icons/Icon.astro';
---

<div
  id="circle-orbit-container"
  class="relative m-auto mt-2 mb-5 h-[200px] w-[200px]"
>
  {/* Inner orbit (recibos) */}
  <div
    class="border-dokei-secondary absolute top-1/2 left-1/2 h-[100px] w-[100px] -translate-x-1/2 -translate-y-1/2 transform rounded-full border border-dashed"
  >
    <p
      class="dm-sans absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 transform text-lg"
    >
      <span class="text-dokei-primary font-semibold">Dokei</span>
    </p>
    <Icon
      name="fileText"
      class="text-dokei-muted-foreground absolute -top-1 right-16 size-6"
    />
  </div>

  {/* Middle orbit (calculadora) */}
  <div
    class="border-dokei-secondary/60 absolute top-1/2 left-1/2 h-[150px] w-[150px] -translate-x-1/2 -translate-y-1/2 transform rounded-full border border-dashed"
  >
    <Icon
      name="calculator"
      class="text-dokei-muted-foreground absolute bottom-1 left-1 size-8"
    />
  </div>

  {/* Outer orbit (obrigações) */}
  <div
    class="border-dokei-border absolute top-1/2 left-1/2 h-[200px] w-[200px] -translate-x-1/2 -translate-y-1/2 transform rounded-full border border-dashed"
  >
    <Icon
      name="bell"
      class="text-dokei-muted-foreground absolute top-2 right-2 size-8"
    />
  </div>
</div>
