---
import Icon from '@ui/icons/Icon.astro';

interface Props {
  address: string;
  email: string;
  phone?: string;
}

const { address, phone, email } = Astro.props;
---

<div>
  <h3 class="text-dokei-primary font-semibold">Contato</h3>
  <ul class="text-dokei-muted-foreground mt-3 space-y-2 text-sm">
    <li>Dokei</li>
    <li>{address}</li>
    {
      phone && (
        <li class="flex items-center gap-x-2">
          <Icon name="mobile" />
          <a
            href={'tel:+' + phone.replace(/[^+\d]/g, '')}
            class="hover:text-dokei-primary transition-colors duration-300"
          >
            {phone}
          </a>
        </li>
      )
    }
    <li class="flex items-center gap-x-2">
      <Icon name="email" />
      <a
        href={'mailto:' + email}
        class="hover:text-dokei-primary transition-colors duration-300"
        >{email}</a
      >
    </li>
  </ul>
</div>
