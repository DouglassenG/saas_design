---
import { Image } from 'astro:assets';
import image_1 from '@images/toolbar.webp';
import image_2 from '@images/graph.webp';
import image_3 from '@images/dashboard.webp';

// Content for the section title and subtitle
const title = `Tudo que você precisa para gerir seu MEI com a <span class="text-dokei-accent">Dokei</span>`;
const subTitle = `Ferramentas simples e poderosas pensadas especialmente para quem empreende sozinho. Foque no que importa: fazer seu negócio crescer.`;

// Features list for displaying the key highlights

const features = [
  {
    title: 'Controle Financeiro', // Feature title
    description:
      'Registre entradas e saídas separando negócio do pessoal. Visualize sua saúde financeira de forma clara.', // Feature description
    image: image_1, // Associated image
    class:
      'content-center border-b border-dashed border-slate-400 py-5 sm:col-span-2 sm:p-5', // Custom CSS classes for layout and styling
    alignment: 'mx-auto mt-10 rounded-xl shadow-lg sm:w-[75%]', // Alignment and styling for the image
  },
  {
    title: 'Declaração de Rendimentos',
    description: `Veja <span class="font-bold">quanto movimentou no ano</span> e declare seu <span class="font-bold">faturamento MEI</span> sem complicações.`,
    image: image_2,
    class: 'content-center py-5 sm:row-start-2 sm:p-5 sm:py-10',
    alignment:
      'ml-auto mr-auto mt-10 w-[65%] rounded-xl shadow-lg sm:ml-0 sm:w-[45%]',
  },
  {
    title: 'Lembretes DAS',
    description:
      'Nunca perca o prazo do seu DAS e obrigações fiscais. Acompanhe em um só painel o que está pendente, pago ou atrasado.',
    image: image_3,
    class:
      'content-center border-t border-dashed border-slate-400 py-5 sm:row-span-2 sm:row-start-2 sm:border-l sm:border-t-0 sm:p-5 sm:text-right',
    alignment: 'ml-auto mr-auto mt-10 w-[80%] rounded-xl shadow-lg sm:mr-0',
  },
  {
    title: 'E muito mais...',
    class: 'content-center border-t border-dashed border-slate-400 py-5 sm:p-5',
    moreFeatures: [
      'Gere recibos profissionais em PDF e compartilhe pelo WhatsApp com apenas alguns cliques',
      'Descubra quanto cobrar pelo seu serviço em 30 segundos com a Calculadora de Preço',
      'Tire dúvidas sobre MEI e sobre a plataforma com a assistente virtual Kauane',
      'Use no computador, tablet ou celular, com seus dados tratados conforme a LGPD',
    ],
  },
];
---

<div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20">
  {/* Section container for the title and subtitle */}
  <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
    <h2
      class="text-2xl font-semibold text-dokei-primary text-balance md:text-3xl md:leading-tight"
    >
      <Fragment set:html={title} />
    </h2>
    <p class="mt-1 text-pretty text-slate-600">
      <Fragment set:html={subTitle} />
    </p>
  </div>

  <div
    class="mx-auto grid max-w-[85rem] px-4 pb-10 sm:grid-cols-2 sm:grid-rows-3 sm:px-6 lg:px-8 lg:pb-14"
  >
    {
      features.map(feature => (
        <div class={`${feature.class}`}>
          <h2 class="text-dokei-muted-foreground text-2xl font-bold">{feature.title}</h2>

          <p class="mt-2 text-base/6 text-slate-600">
            <Fragment set:html={feature.description || ''} />
          </p>

          {feature.image && (
            <Image
              class={`${feature.alignment || ''}`}
              src={feature.image}
              alt=""
            />
          )}

          {feature.moreFeatures && (
            <ul class="mt-4 ml-4 w-4/5 list-inside list-disc space-y-2 text-base/6 text-slate-600 marker:text-dokei-accent">
              {feature.moreFeatures.map(item => (
                <li>{item}</li>
              ))}
            </ul>
          )}
        </div>
      ))
    }
  </div>
</div>
