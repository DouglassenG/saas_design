---
import FooterFormExpanded from '@ui/forms/FooterFormExpanded.astro';

// Import data for dynamic rendering
import { featuresMenu } from '@utils/megaMenu/features';
import { platformMenu } from '@utils/megaMenu/platform';
import { supportMenu } from '@utils/megaMenu/support';

// Props for customization
const companyName = 'Dokei';
const companyDescription =
  'Simplifique a gestão do seu MEI. Ferramentas simples para você focar no que realmente importa: fazer seu negócio crescer.';

// Contact information for the company
const contactFormDescription = 'Newsletter em configuração.';

// Dynamic date for copyright display
const copyrightYear = new Date().getFullYear();

// Developer or team behind the website
const craftedBy = { name: 'gulamoff', url: 'https://github.com/mearashadowfax' };

// Rights notice
const trademarkNotice = 'Todos os direitos reservados.';
---

<footer
  class="mt-auto from-dokei-muted w-full bg-linear-to-t/srgb via-transparent to-white pb-10"
>
  <div class="mx-auto mt-auto w-full max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8">
    <hr class="mb-10 border-dokei-border" />

    <div class="mb-10 grid grid-cols-2 gap-6 md:grid-cols-4 lg:grid-cols-5">
      {/* Company Information */}
      <div class="col-span-full self-center xl:col-span-2">
        <a
          href="#"
          class="flex-none text-xl font-semibold text-dokei-primary uppercase focus:opacity-80 focus:outline-hidden"
          aria-label="Dokei - página inicial"
        >
          {companyName}
        </a>
        <p class="mt-5 text-pretty text-slate-600 lg:w-5/12 xl:w-10/12">
          {companyDescription}
        </p>
      </div>

      {/* Features Links */}
      <div>
        <h3 class="font-semibold text-dokei-primary">Serviços</h3>
        <div class="mt-3 text-sm">
          <ul class="space-y-3">
            {
              featuresMenu
                .flatMap(feature => feature.items)
                .map(item => (
                  <li>
                    <a class="text-sm text-slate-600" href={item.href}>
                      {item.title}
                    </a>
                  </li>
                ))
            }
          </ul>
        </div>
      </div>

      {/* Products Links */}
      <div>
        <h3 class="font-semibold text-dokei-primary">Plataforma</h3>
        <div class="mt-3 text-sm">
          <ul class="space-y-3">
            {
              platformMenu.map(platform => (
                <li>
                  <a class="text-sm text-slate-600" href={platform.href}>
                    {platform.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      {/* Support Links */}
      <div>
        <h3 class="font-semibold text-dokei-primary">Ajuda</h3>
        <div class="mt-3 text-sm">
          <ul class="space-y-3">
            {
              supportMenu
                .flatMap(support => support.items)
                .map(item => (
                  <li>
                    <a class="text-sm text-slate-600" href={item.href}>
                      {item.title}
                    </a>
                  </li>
                ))
            }
          </ul>
        </div>
      </div>
    </div>

    {/* Divider before subscription form section */}
    <hr class="my-10 border-dokei-border" />

    {/* Email Subscription Form */}
    <div
      class="flex w-full flex-col items-start justify-between md:flex-row md:items-center md:gap-x-5"
    >
      <div class="mb-5 md:mb-0 md:w-1/2">
        <h3 class="font-semibold text-dokei-primary">Newsletter</h3>
        <p class="mt-3 text-sm text-slate-400">
          {contactFormDescription}
        </p>
      </div>
      <FooterFormExpanded />
    </div>

    {/* Divider before footer's bottom section */}
    <hr class="mt-10 mb-5 border-dokei-border" />

    <div
      class="grid gap-y-2 sm:flex sm:items-center sm:justify-between sm:gap-y-0"
    >
      {/* Copyright and Crafted By Section */}
      <p class="text-sm text-dokei-muted-foreground">
        &copy; {copyrightYear}
        {companyName} Crafted by {' '}
        <a
          href={craftedBy.url}
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium underline underline-offset-2 ring-slate-400 outline-hidden transition duration-300 hover:text-slate-400 hover:decoration-dashed focus:outline-hidden focus-visible:ring-3"
        >
          {craftedBy.name}
        </a>  <br>
        Distributed by {' '}
        <a
          href={'https://themewagon.com'}
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium underline underline-offset-2 ring-slate-400 outline-hidden transition duration-300 hover:text-slate-400 hover:decoration-dashed focus:outline-hidden focus-visible:ring-3"
        >
          ThemeWagon
        </a>
      </p>

      {/* Trademark Notice */}
      <p class="text-sm text-dokei-muted-foreground">
        <Fragment set:html={trademarkNotice} />
      </p>
    </div>
  </div>
</footer>
