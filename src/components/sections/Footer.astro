---
import FooterForm from '@ui/forms/FooterForm.astro';
import ContactInfo from '@common/ContactInfo.astro';
import { navigationLinks } from '@utils/navigation';

// Props for customization
const companyName = 'Dokei';
const companyDescription =
  'Simplifique a gestão do seu MEI. Ferramentas simples para você focar no que realmente importa: fazer seu negócio crescer.';

// Contact information for the company
const contactDetails = {
  address: 'São Paulo, Brasil',
  email: 'contato@dokei.com.br',
};

// Dynamic date for copyright display
const copyrightYear = new Date().getFullYear();

// Developer or team behind the website
const craftedBy = {
  // name: 'gulamoff',
  url: 'https://github.com/mearashadowfax',
};
---

<footer
  class="from-dokei-muted mt-auto w-full bg-linear-to-t/srgb via-transparent to-white pb-10"
>
  <div class="mx-auto mt-auto w-full max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8">
    <hr class="border-dokei-border mb-10" />

    <div class="grid grid-cols-2 gap-6 md:grid-cols-5">
      {/* Company Information */}
      <div class="col-span-full self-center xl:col-span-2">
        <a
          href="/"
          class="relative block h-14 w-27 flex-none overflow-hidden focus:opacity-80 focus:outline-hidden"
          aria-label="Dokei - página inicial"
        >
          <img
            src="/logotipo_site_2.png"
            alt="Dokei"
            width="2736"
            height="1536"
            class="absolute -top-[41px] -left-[71px] h-[137px] w-[244px] max-w-none mix-blend-multiply brightness-135"
          />
        </a>
        <p
          class="text-dokei-muted-foreground mt-5 text-pretty lg:w-5/12 xl:w-10/12"
        >
          {companyDescription}
        </p>
        <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          {
            navigationLinks.map(link => (
              <li>
                <a
                  href={link.href}
                  class="text-dokei-muted-foreground hover:text-dokei-primary transition-colors duration-300"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Contact Information Section */}
      <div class="col-span-1 md:col-span-2 xl:col-span-1 xl:col-start-3">
        <ContactInfo {...contactDetails} />
      </div>

      {/* Email Subscription Form */}
      <div class="col-span-2 md:col-span-3 xl:col-span-2">
        <h3 class="text-dokei-primary font-semibold">Newsletter</h3>
        <FooterForm />
      </div>
    </div>

    {/* Divider before footer's bottom section */}
    <hr class="border-dokei-border mt-10 mb-5" />

    <div
      class="grid gap-y-2 sm:flex sm:items-center sm:justify-between sm:gap-y-0"
    >
      {/* Copyright and Crafted By Section */}
      <p class="text-dokei-muted-foreground text-sm">
        &copy; {copyrightYear}{' '}
        {companyName}. Todos os direitos reservados.  {' '}
        <a
          href={craftedBy.url}
          target="_blank"
          rel="noopener noreferrer"
          class="ring-dokei-secondary hover:text-dokei-primary font-medium underline underline-offset-2 outline-hidden transition duration-300 hover:decoration-dashed focus:outline-hidden focus-visible:ring-3"
        >
        </a>
        <br />        
      </p>
    </div>
  </div>
</footer>
