---
import Button from '@ui/Button.astro';

// Content for the section title and subtitle
const title =
  'Pronto para simplificar <br /> a gestão do seu MEI com a <span class="font-medium text-dokei-secondary">Dokei</span>?';
const subTitle =
  'Ferramentas simples para você focar no que realmente importa: fazer seu negócio crescer.';

// Call-to-action configuration for the primary button
const primaryCTA = {
  text: 'Começar grátis agora',
  href: 'https://dokei-web-xhrp.vercel.app/cadastro',
};
---

<section
  class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20"
>
  <div class="mx-auto mb-10 max-w-3xl text-center lg:mb-14">
    <h2 class="text-4xl text-balance text-dokei-primary sm:text-5xl">
      <Fragment set:html={title} />
    </h2>
    <p class="text-lg\/8 mt-5 text-pretty text-slate-600">
      {subTitle}
    </p>
    <Button
      href={primaryCTA.href}
      variant="primary"
      className="bg-dokei-primary hover:bg-dokei-primary/80 focus:bg-dokei-primary/80 mt-7 inline-flex border-none px-3.5!">{primaryCTA.text}</Button
    >
  </div>
</section>
