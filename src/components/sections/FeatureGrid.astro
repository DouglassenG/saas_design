---
import Icon from '@ui/icons/Icon.astro';

// Content for the section title and subtitle
const title =
  'Por que escolher a <span class="text-dokei-accent">Dokei</span>?';
const subTitle =
  'A Dokei nasceu para resolver um problema real: a falta de ferramentas simples e acessíveis para o Microempreendedor Individual organizar seu negócio. Sem planilhas complicadas, sem mensalidades, sem complicação.';

const features = [
  {
    borderClasses: 'md:border-l md:border-r',
    gradientClasses: 'bg-linear-to-l/srgb from-dokei-border to-transparent',
    icon: 'cursorRays',
    heading: 'Nossa Missão',
    description:
      'Simplificar a rotina de quem empreende sozinho, tirando a burocracia do caminho para você focar em fazer seu negócio crescer.',
  },
  {
    borderClasses: 'border-b border-t md:border-b-0',
    gridClasses: 'md:col-start-2 md:col-end-3',
    gradientClasses: 'bg-linear-to-t/srgb from-dokei-border to-transparent',
    icon: 'badge',
    heading: '100% Gratuito',
    description:
      'Acreditamos que todo MEI merece boas ferramentas de gestão sem pagar por isso. Por isso a Dokei é e continuará sendo gratuita.',
  },
  {
    borderClasses: 'md:border-l md:border-r md:border-t',
    gridClasses: 'md:col-end-4',
    gradientClasses: 'bg-linear-to-tl/srgb from-dokei-border to-transparent',
    icon: 'puzzle',
    heading: 'Compromisso com Você',
    description:
      'Construímos a Dokei ouvindo quem vive a realidade do MEI todos os dias, sempre priorizando simplicidade e segurança dos seus dados.',
  },
];
---

<section
  class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20"
>
  <div
    class="grid grid-flow-row-dense grid-cols-1 md:grid-cols-3 md:grid-rows-2"
  >
    {/* Section container for the title and subtitle */}
    <div
      class="mx-auto max-w-lg pb-5 text-center md:col-span-2 lg:mx-0 lg:flex-auto lg:text-left"
    >
      <h2
        class="text-2xl font-semibold tracking-tight text-balance text-dokei-primary md:text-3xl md:leading-tight"
      >
        <Fragment set:html={title} />
      </h2>
      <p
        class="mt-6 text-start text-lg/8 text-pretty text-slate-700 sm:text-center md:text-start"
      >
        {subTitle}
      </p>
    </div>

    {/* Feature Cards */}
    {
      features &&
        features.map(feature => (
          <div
            class={`group relative mx-auto flex flex-col border-dashed border-slate-400 py-10 ${feature.borderClasses} ${feature.gridClasses}`}
          >
            <div
              class={`group pointer-events-none absolute inset-0 h-full w-full ${feature.gradientClasses} opacity-0 transition duration-300 group-hover:opacity-100`}
            />
            <div class="relative z-10 mb-4 px-10">
              <Icon name={feature.icon} class="text-dokei-accent! size-6" />
            </div>
            <div class="relative z-10 mb-2 px-10 text-lg font-semibold">
              <span class="inline-block text-balance text-dokei-primary transition duration-300 group-hover:translate-x-2">
                {feature.heading}
              </span>
            </div>
            <p class="z-10 max-w-sm px-4 text-sm text-pretty text-slate-700 sm:max-w-lg md:mx-auto">
              {feature.description}
            </p>
          </div>
        ))
    }
  </div>
</section>
