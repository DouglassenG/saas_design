---
import Features from '@megaMenu/Features.astro';
import Button from '@ui/Button.astro';
import { navigationLinks } from '@utils/navigation';

const currentPath = Astro.url.pathname;

// Call-to-action configuration for the primary button
const primaryCTA = {
  text: 'Começar grátis',
  href: 'https://dokei-web-xhrp.vercel.app/cadastro',
};

const loginLink = {
  text: 'Entrar',
  href: 'https://dokei-web-xhrp.vercel.app/login',
};
---

<header
  class="border-dokei-border from-dokei-muted xl:ring-dokei-primary/5 fixed start-1/2 top-5 z-50 mx-auto flex w-full max-w-sm -translate-x-1/2 transform flex-wrap rounded-2xl border-b bg-white bg-linear-to-t/srgb via-transparent to-white p-4 shadow-xs sm:max-w-xl md:max-w-4xl md:flex-nowrap md:justify-start lg:max-w-5xl xl:max-w-6xl xl:shadow-none 2xl:max-w-[81rem] 2xl:via-0%"
>
  <nav
    class="relative mx-auto w-full px-4 py-2 sm:px-6 lg:px-8 xl:flex xl:max-w-7xl xl:items-center xl:justify-between xl:gap-3 2xl:max-w-[85rem]"
  >
    <div class="flex items-center justify-between gap-x-1">
      <a
        class="relative block h-14 w-27 flex-none overflow-hidden focus:opacity-80 focus:outline-hidden"
        href="/"
        aria-label="Dokei - página inicial"
        translate="no"
      >
        <img
          src="/logotipo_site_2.png"
          alt="Dokei"
          width="2736"
          height="1536"
          class="absolute -top-[41px] -left-[71px] h-[137px] w-[244px] max-w-none mix-blend-multiply brightness-135"
        />
      </a>

      <button
        type="button"
        class="hs-collapse-toggle border-dokei-border text-dokei-primary hover:bg-dokei-muted focus:bg-dokei-muted relative flex size-9 items-center justify-center rounded-lg border text-[12px] font-medium focus:outline-hidden xl:hidden"
        id="hs-header-base-collapse"
        aria-expanded="false"
        aria-controls="hs-header-base"
        aria-label="Alternar navegação"
        data-hs-collapse="#hs-header-base"
      >
        <svg
          class="hs-collapse-open:hidden size-4"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="3" x2="21" y1="6" y2="6"></line><line
            x1="3"
            x2="21"
            y1="12"
            y2="12"></line><line x1="3" x2="21" y1="18" y2="18"></line></svg
        >
        <svg
          class="hs-collapse-open:block hidden size-4 shrink-0"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
        >
        <span class="sr-only">Alternar navegação</span>
      </button>
    </div>

    <div
      id="hs-header-base"
      class="hs-collapse hidden grow basis-full overflow-hidden transition-all duration-300 xl:ml-12 xl:block 2xl:ml-20"
      aria-labelledby="hs-header-base-collapse"
    >
      <div
        class="[&::-webkit-scrollbar-thumb]:bg-dokei-border [&::-webkit-scrollbar-track]:bg-dokei-muted max-h-[75vh] overflow-hidden overflow-y-auto [&::-webkit-scrollbar]:w-2 [&::-webkit-scrollbar-thumb]:rounded-full"
      >
        <div
          class="flex flex-col gap-0.5 py-2 xl:flex-row xl:items-center xl:gap-1 xl:py-0"
        >
          <div class="grow">
            <div
              class="flex flex-col gap-0.5 xl:flex-row xl:items-center xl:justify-evenly xl:gap-1"
            >
              <a
                href="/"
                class={`flex items-center rounded-lg p-2 font-medium text-dokei-primary hover:bg-dokei-muted focus:bg-dokei-muted focus:outline-hidden ${
                  currentPath === '/' ? 'underline underline-offset-4' : ''
                }`}
                aria-current={currentPath === '/' ? 'page' : undefined}
              >
                Início
              </a>

              <Features />

              {
                navigationLinks.map(link => (
                  <a
                    href={link.href}
                    class={`text-dokei-primary hover:bg-dokei-muted focus:bg-dokei-muted flex items-center rounded-lg p-2 font-medium focus:outline-hidden ${
                      currentPath === link.href
                        ? 'underline underline-offset-4'
                        : ''
                    }`}
                    aria-current={
                      currentPath === link.href ? 'page' : undefined
                    }
                  >
                    {link.label}
                  </a>
                ))
              }
            </div>
          </div>

          <div
            class="mt-5 flex flex-wrap items-center gap-x-1.5 xl:mt-0 xl:ml-6"
          >
            <a
              href={loginLink.href}
              class="text-dokei-primary hover:bg-dokei-muted focus:bg-dokei-muted rounded-lg p-2 font-medium text-nowrap focus:outline-hidden"
            >
              {loginLink.text}
            </a>
            <Button
              href={primaryCTA.href}
              variant="primary"
              className="bg-dokei-primary hover:bg-dokei-primary/80 focus:bg-dokei-primary/80 inline-flex border-none py-2! text-nowrap"
              >{primaryCTA.text}</Button
            >
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  document.addEventListener('astro:page-load', async () => {
    const { HSStaticMethods } = await import('preline');
    HSStaticMethods.autoInit();
  });
</script>
